{
  "name": "dsh-speed-gauge",
  "version": "1.0.5",
  "private": false,
  "description": "A generation-speed gauge for DSH: a half-circle dial and a flowing trend curve, sampling tok/s 50 times a second for finer, more accurate measurement; tuck it away with a header button at any time.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dashboard",
    "token",
    "tok/s",
    "speed",
    "gauge",
    "monitor"
  ],
  "license": "MIT",
  "type": "module",
  "main": "host.js",
  "exports": {
    ".": {
      "default": "./host.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "sampler.js",
    "client.js",
    "panel-worker.js",
    "cordis.patch.yml",
    "LICENSE",
    "CHANGELOG.md",
    "RELEASE.md",
    "shots/promo.png",
    "shots/preview-light.png",
    "shots/preview-dark.png",
    "README.md",
    "README.en.md",
    "shots/how-to-open.png",
    "screenshots.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoreanP2003/dsh-speed-gauge.git"
  },
  "homepage": "https://github.com/MoreanP2003/dsh-speed-gauge#readme",
  "bugs": {
    "url": "https://github.com/MoreanP2003/dsh-speed-gauge/issues"
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-speed-gauge",
    "summary": "给 DSH 加一个生成速度仪表盘：半圆表盘与流动曲线趋势图，一秒 50 次获取 tok/s，测量更细更精准，可随时用标题栏按钮收起。",
    "categories": [
      "观测",
      "Web UI"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "compatibility": {
      "dsh": ">=0.2.1-rc.2",
      "node": ">=20"
    },
    "permissions": {
      "network": []
    }
  }
}
